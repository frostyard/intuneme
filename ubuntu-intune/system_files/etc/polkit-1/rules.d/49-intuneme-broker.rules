// Session processes use no_new_privs: authorize this D-Bus operation instead of sudo.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "microsoft-identity-device-broker.service" &&
        action.lookup("verb") == "restart" && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
