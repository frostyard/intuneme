#!/bin/bash
# intuneme hotplug handler — forwards devices to nspawn container.
# Managed by intuneme — do not edit manually.
set -euo pipefail

ACTION="${1:-}"
DEVNODE="${2:-}"
MACHINE="{{.Machine}}"
STATE_DIR="/run/intuneme/devices"
LOG_TAG="intuneme-hotplug"

log() { logger -t "$LOG_TAG" "$@" 2>/dev/null || true; }

[ -z "$ACTION" ] || [ -z "$DEVNODE" ] && exit 0

# Check if container is running.
LEADER=$(machinectl show "$MACHINE" -p Leader --value 2>/dev/null) || exit 0
[ -z "$LEADER" ] || [ "$LEADER" = "0" ] && exit 0

state_file() { echo "$STATE_DIR/$(echo "$1" | tr / _)"; }

case "$ACTION" in
  add)
    [ ! -e "$DEVNODE" ] && { log "add: $DEVNODE does not exist, skipping"; exit 0; }

    # Get device major:minor (hex).
    MAJOR=$(stat -c '0x%t' "$DEVNODE" 2>/dev/null) || { log "add: cannot stat $DEVNODE"; exit 0; }
    MINOR=$(stat -c '0x%T' "$DEVNODE" 2>/dev/null) || exit 0

    # Allow the device in the container's cgroup. The scope unit name is NOT
    # always "machine-<name>.scope": newer systemd (v256+) has nspawn allocate
    # its own scope named "<name>.scope", so ask machined for the real unit
    # (same as nspawn.MachineUnit() in Go). Without this, mknod below still
    # succeeds but every open() inside the container fails with EPERM because
    # nspawn's DevicePolicy=closed cgroup filter rejects the device.
    # DevicePolicy=auto preserves the existing policy and adds our device on top.
    UNIT=$(machinectl show "$MACHINE" -p Unit --value 2>/dev/null) || UNIT=""
    if [ -z "$UNIT" ]; then
      log "add: cannot resolve scope unit for $MACHINE; $DEVNODE will be inaccessible (EPERM) in the container"
    elif ! systemctl set-property "$UNIT" DevicePolicy=auto "DeviceAllow=$DEVNODE rwm" 2>/dev/null; then
      log "add: DeviceAllow failed for $DEVNODE on $UNIT; device will be inaccessible (EPERM) in the container"
    fi

    # Create device node inside container.
    nsenter -t "$LEADER" -m -- mkdir -p "$(dirname "$DEVNODE")" 2>/dev/null || true
    nsenter -t "$LEADER" -m -- rm -f "$DEVNODE" 2>/dev/null || true
    nsenter -t "$LEADER" -m -- mknod "$DEVNODE" c "$MAJOR" "$MINOR" 2>/dev/null || {
      log "add: mknod failed for $DEVNODE"; exit 0
    }
    # Use restrictive permissions for video/media devices (matching host model).
    case "$(basename "$DEVNODE")" in
      video*|media*)
        nsenter -t "$LEADER" -m -- chgrp video "$DEVNODE"
        nsenter -t "$LEADER" -m -- chmod 0660 "$DEVNODE"
        ;;
      *)
        nsenter -t "$LEADER" -m -- chmod 0666 "$DEVNODE"
        ;;
    esac

    # Record forwarded device.
    mkdir -p "$STATE_DIR"
    echo "$DEVNODE" > "$(state_file "$DEVNODE")"
    log "add: forwarded $DEVNODE to $MACHINE"
    ;;

  remove)
    SF="$(state_file "$DEVNODE")"
    [ ! -f "$SF" ] && exit 0

    nsenter -t "$LEADER" -m -- rm -f "$DEVNODE" 2>/dev/null || true
    rm -f "$SF"
    log "remove: removed $DEVNODE from $MACHINE"
    ;;
esac
