// Allow users in the sudo or wheel group to open an interactive shell in a
// local container without authentication. Machine management and host shells
// are deliberately not granted here; intuneme uses a scoped root-owned helper
// for stop/bind instead.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.machine1.shell" &&
        (subject.isInGroup("sudo") || subject.isInGroup("wheel"))) {
        return polkit.Result.YES;
    }
});
