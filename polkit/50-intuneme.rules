// Reference only. The CLI renders the actual rule with the configured machine,
// caller UID, and target username. No broad group grants belong here.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.machine1.shell" &&
        subject.uid == 1000 &&
        action.lookup("machine") == "intuneme" &&
        action.lookup("user") == "example-user") {
        return polkit.Result.YES;
    }
});
